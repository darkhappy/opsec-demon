# Optional local environment; the shell does not automatically load this file.
# No API key is required. Music tokens are inspected only for presence.
STARSHIP_CONFIG=
KUBECONFIG=
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_USER_TOKEN=
# Optional public Discord application ID; enables Rich Presence in interactive sessions.
# No Discord bot token, user token, or client secret is needed.
DISCORD_APPLICATION_ID=
